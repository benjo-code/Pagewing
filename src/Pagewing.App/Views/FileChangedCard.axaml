<views:SaveCard xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:Pagewing.App.ViewModels"
                xmlns:views="using:Pagewing.App.Views"
                xmlns:ctl="using:Pagewing.App.Controls"
                x:Class="Pagewing.App.Views.FileChangedCard"
                x:DataType="vm:PendingSave"
                AutomationProperties.Name="{Binding Title}"
                AutomationProperties.HelpText="{Binding Message}">
  <!--
    Another file stands at the path of the original since it was opened (design system 7.14, PendingSaveKind.FileChanged):
    warning symbol in danger.default, title ""<file>" was replaced since it was opened", the text, "Overwrite" (locked for
    the first 400 ms), "Save as" (primary, focus and Enter) and "Cancel". Card and buttons as SaveCard.
  -->
  <Border Name="FileChangedBox" MaxWidth="480" Margin="24" Padding="24"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          CornerRadius="{StaticResource Pw.Radius.Overlay}"
          Background="{DynamicResource Pw.Brush.Surface.Raised}"
          BoxShadow="{DynamicResource Pw.Shadow.Card}">
    <StackPanel Spacing="12">
      <ctl:StrokeIcon Name="FileChangedIcon" Width="24" Height="24" HorizontalAlignment="Left"
                      Data="{StaticResource Pw.Icon.AlertTriangle}"
                      Brush="{DynamicResource Pw.Brush.Danger.Default}" />
      <StackPanel Spacing="4">
        <TextBlock Name="FileChangedTitle" Classes="subtitle" TextWrapping="Wrap" Text="{Binding Title}"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Name="FileChangedText" Classes="body" TextWrapping="Wrap"
                   Foreground="{DynamicResource Pw.Brush.Text.Secondary}"
                   Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <StackPanel Name="FileChangedButtons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="FileChangedOverwriteButton" />
        <Button Name="FileChangedSaveAsButton" />
        <Button Name="FileChangedCancelButton" />
      </StackPanel>
    </StackPanel>
  </Border>
</views:SaveCard>
