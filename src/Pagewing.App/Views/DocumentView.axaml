<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Pagewing.App.Controls"
             x:Class="Pagewing.App.Views.DocumentView">
  <!--
    Document area with continuous scrolling (design system 6 and 7.5): the pages centred one below the other, 20 apart,
    with a 32 margin all round. The ScrollViewer only scrolls an empty extent of the content size; the canvas below it
    draws the visible pages in viewport coordinates (see DocumentCanvas). The ScrollViewer is transparent but
    hit-testable, so wheel, scroll bars and the pointer work everywhere; the canvas takes no input.
  -->
  <Panel>
    <ctl:DocumentCanvas Name="PageCanvas"
                        CornerRadius="10,0,0,0"
                        PlaceholderBrush="{DynamicResource Pw.Brush.Surface.Raised}"
                        PlaceholderBorderBrush="{DynamicResource Pw.Brush.Border.Subtle}"
                        PlaceholderTextBrush="{DynamicResource Pw.Brush.Text.Secondary}"
                        PageShadow="{DynamicResource Pw.Shadow.Page}" />
    <ScrollViewer Name="Scroller"
                  Background="Transparent"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <Panel Name="Extent" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </ScrollViewer>
  </Panel>
</UserControl>
