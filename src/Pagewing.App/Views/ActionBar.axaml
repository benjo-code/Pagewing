<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             x:Class="Pagewing.App.Views.ActionBar"
             x:DataType="vm:MainViewModel"
             Width="52"
             Background="{DynamicResource Pw.Brush.Surface.Window}">
  <!--
    Action bar (design system sections 5.4, 5.5, 6 and 7.3): 52 px wide on surface.window, buttons 40 px with 20 px
    icons in text.secondary. A click opens the panel of the entry in the active tab, a click on the active entry closes
    it (MainViewModel.ToggleSidePanelCommand). The active entry has an accent.subtle surface behind an accent.default
    icon, so it is not marked by colour alone (section 7.10); hovering it keeps that. Search (M5) and settings (M6)
    follow when they exist. Part of the first frame with a tab, so it stays this small.
  -->
  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Text.Secondary}" />
    </Style>
    <Style Selector="Button.action.active">
      <Setter Property="Background" Value="{DynamicResource Pw.Brush.Accent.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Accent.Default}" />
    </Style>
    <Style Selector="Button.action.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.action.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Pw.Brush.Accent.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Accent.Default}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="4" Margin="0,4,0,8" HorizontalAlignment="Center">
    <Button Name="PagesButton" Classes="icon action" Classes.active="{Binding IsPagesPanelOpen}"
            Command="{Binding ToggleSidePanelCommand}" CommandParameter="{x:Static vm:SidePanelKind.Pages}"
            ToolTip.Tip="{x:Static res:Strings.PagesTooltip}"
            AutomationProperties.Name="{x:Static res:Strings.PagesTooltip}">
      <ctl:StrokeIcon Width="20" Height="20" Data="{StaticResource Pw.Icon.LayoutGrid}" />
    </Button>
    <Button Name="ContentsButton" Classes="icon action" Classes.active="{Binding IsContentsPanelOpen}"
            Command="{Binding ToggleSidePanelCommand}" CommandParameter="{x:Static vm:SidePanelKind.Contents}"
            ToolTip.Tip="{x:Static res:Strings.ContentsTooltip}"
            AutomationProperties.Name="{x:Static res:Strings.ContentsTooltip}">
      <ctl:StrokeIcon Width="20" Height="20" Data="{StaticResource Pw.Icon.ListTree}" />
    </Button>
  </StackPanel>
</UserControl>
