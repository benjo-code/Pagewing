<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             xmlns:red="using:Pagewing.Core.Redaction"
             x:Class="Pagewing.App.Views.RedactionToolbar"
             x:DataType="vm:TabViewModel"
             AutomationProperties.Name="{x:Static res:Strings.RedactToolbarName}"
             AutomationProperties.AccessibilityView="Content">
  <!--
    Toolbar of the mode "Redact" (milestone 14; design system 6 point 4 and 7.7, built like the toolbars of "Comment" and
    "Fill in form"): 44 px high (density "Kompakt" 38, Pw.Size.ToolbarHeight) over the document area, surface.toolbar with a
    border.subtle bottom edge. From the left: the name of the mode with its icon (eye-off, accent.default); the two tools of the
    pointer, "Area" and "Text" (toggle buttons for screen readers; the chosen one has an accent.subtle surface, an accent.default
    1 px frame, icon and label, so it is not marked by colour alone); "Mark selection"; "Find and redact" (a toggle that shows the
    panel "Redact" with the search and the list of marks, with the focus in its field); the fill, "Black" and "White", two
    toggle buttons that name their colour in words; Undo and Redo; Delete mark. On the right the counter of the marks ("4 marks
    on 2 pages"), the hint that nothing is removed before the marks are applied, "Discard" and the primary button "Done", which
    leaves the mode and is possible while no mark waits (with marks they are applied or discarded; the tooltip says so). With
    marks the primary button is "Apply …" (task 13: it opens the card with the numbers, the lists and the choice where to save),
    and "Preview" (a toggle after the tools) shows the marks as the filled areas they will leave and a second row under the bar
    with the numbers of what is removed; it changes nothing in the file. Tab
    moves through them in this order; Enter and Space press; Esc drops a drag, then the selected marks, then the text
    selection, then ends the mode. Too narrow (640 px window, German): first the hint goes, then the labels of the tools, the
    preview and the fill, then the text of the mode name, then its icon, then the counter text (the counter stays the name of
    the toolbar for screen readers), then the words of "Done" and "Discard", then the words of "Apply", last the words "Black" and "White" give way to a swatch of their colour (icons, tooltips and names stay). Made when the mode is first started (MainWindow.Redaction.cs), never in the startup path; its styles live
    here for the same reason. The DataContext is the active tab.
  -->
  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Text.Primary}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool.active">
      <Setter Property="Background" Value="{DynamicResource Pw.Brush.Accent.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pw.Brush.Accent.Default}" />
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Accent.Default}" />
    </Style>
    <Style Selector="Button.tool.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Pw.Brush.Accent.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pw.Brush.Accent.Default}" />
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Accent.Default}" />
    </Style>
    <Style Selector="Button.tool TextBlock">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbarIcon">
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Text.Primary}" />
    </Style>
    <Style Selector="Border.toolbarSeparator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Background" Value="{DynamicResource Pw.Brush.Border.Subtle}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Name="ToolbarFrame"
          Background="{DynamicResource Pw.Brush.Surface.Toolbar}"
          BorderBrush="{DynamicResource Pw.Brush.Border.Subtle}"
          BorderThickness="0,0,0,1">
    <StackPanel>
    <Grid Name="ToolbarContent" Height="{DynamicResource Pw.Size.ToolbarHeight}" Margin="12,0,8,0" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Name="ModeLabel" Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
        <ctl:StrokeIcon Name="ModeIcon" Width="18" Height="18" VerticalAlignment="Center"
                        Brush="{DynamicResource Pw.Brush.Accent.Default}" Data="{StaticResource Pw.Icon.EyeOff}" />
        <TextBlock Name="ModeName" Classes="strong" VerticalAlignment="Center"
                   Foreground="{DynamicResource Pw.Brush.Text.Primary}"
                   Text="{x:Static res:Strings.CommandRedactMode}" />
      </StackPanel>

      <StackPanel Name="ToolsArea" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
        <ctl:ActionToggleButton Name="AreaToolButton" Classes="icon tool"
                                Classes.active="{Binding RedactionToolIsArea}" IsChecked="{Binding RedactionToolIsArea, Mode=OneWay}"
                                Command="{Binding ChooseRedactionToolCommand}" CommandParameter="{x:Static vm:RedactionTool.Area}"
                                ToolTip.Tip="{x:Static res:Strings.RedactToolAreaTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RedactToolArea}">
          <StackPanel Orientation="Horizontal">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.Square}" />
            <TextBlock Name="AreaToolLabel" Classes="body" Text="{x:Static res:Strings.RedactToolArea}" />
          </StackPanel>
        </ctl:ActionToggleButton>
        <ctl:ActionToggleButton Name="TextToolButton" Classes="icon tool" Margin="2,0,0,0"
                                Classes.active="{Binding RedactionToolIsText}" IsChecked="{Binding RedactionToolIsText, Mode=OneWay}"
                                Command="{Binding ChooseRedactionToolCommand}" CommandParameter="{x:Static vm:RedactionTool.Text}"
                                ToolTip.Tip="{x:Static res:Strings.RedactToolTextTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RedactToolText}">
          <StackPanel Orientation="Horizontal">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.Typography}" />
            <TextBlock Name="TextToolLabel" Classes="body" Text="{x:Static res:Strings.RedactToolText}" />
          </StackPanel>
        </ctl:ActionToggleButton>
        <Button Name="MarkSelectionButton" Classes="icon tool" Margin="2,0,0,0"
                Command="{Binding MarkSelectionCommand}"
                AutomationProperties.Name="{x:Static res:Strings.RedactMarkSelection}">
          <StackPanel Orientation="Horizontal">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.Highlight}" />
            <TextBlock Name="MarkSelectionLabel" Classes="body" Text="{x:Static res:Strings.RedactMarkSelection}" />
          </StackPanel>
        </Button>
        <ctl:ActionToggleButton Name="FindButton" Classes="icon tool" Margin="2,0,0,0"
                                Classes.active="{Binding IsRedactionPanelOpen}" IsChecked="{Binding IsRedactionPanelOpen, Mode=OneWay}"
                                Command="{Binding ToggleRedactionPanelCommand}"
                                ToolTip.Tip="{x:Static res:Strings.RedactFindTip}"
                                AutomationProperties.Name="{x:Static res:Strings.CommandRedactFind}">
          <StackPanel Orientation="Horizontal">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.Search}" />
            <TextBlock Name="FindLabel" Classes="body" Text="{x:Static res:Strings.CommandRedactFind}" />
          </StackPanel>
        </ctl:ActionToggleButton>

        <Border Classes="toolbarSeparator" />

        <TextBlock Name="FillLabel" Classes="body" VerticalAlignment="Center" Margin="0,0,6,0"
                   Foreground="{DynamicResource Pw.Brush.Text.Secondary}"
                   Text="{x:Static res:Strings.RedactFill}" />
        <ctl:ActionToggleButton Name="FillBlackButton" Classes="icon tool"
                                Classes.active="{Binding IsRedactionFillBlack}" IsChecked="{Binding IsRedactionFillBlack, Mode=OneWay}"
                                Command="{Binding SetRedactionFillCommand}" CommandParameter="{x:Static red:RedactionFill.Black}"
                                ToolTip.Tip="{x:Static res:Strings.RedactFillTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RedactFillBlack}">
          <StackPanel Orientation="Horizontal">
            <Border Name="FillBlackSwatch" Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center" IsVisible="False"
                    BorderThickness="1" BorderBrush="{DynamicResource Pw.Brush.Border.Strong}" />
            <TextBlock Name="FillBlackWord" Classes="body" Margin="0" Text="{x:Static res:Strings.RedactFillBlack}" />
          </StackPanel>
        </ctl:ActionToggleButton>
        <ctl:ActionToggleButton Name="FillWhiteButton" Classes="icon tool" Margin="2,0,0,0"
                                Classes.active="{Binding IsRedactionFillWhite}" IsChecked="{Binding IsRedactionFillWhite, Mode=OneWay}"
                                Command="{Binding SetRedactionFillCommand}" CommandParameter="{x:Static red:RedactionFill.White}"
                                ToolTip.Tip="{x:Static res:Strings.RedactFillTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RedactFillWhite}">
          <StackPanel Orientation="Horizontal">
            <Border Name="FillWhiteSwatch" Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center" IsVisible="False"
                    BorderThickness="1" BorderBrush="{DynamicResource Pw.Brush.Border.Strong}" />
            <TextBlock Name="FillWhiteWord" Classes="body" Margin="0" Text="{x:Static res:Strings.RedactFillWhite}" />
          </StackPanel>
        </ctl:ActionToggleButton>
        <!-- "Colour …": any other colour. A flyout with the hex field (#RRGGBB) and five presets (built in the code behind from
             RedactionFill.Presets, each with its name and a check mark when chosen, so no colour is told by colour alone). The
             button shows a swatch of the colour and an accent frame when the fill is neither black nor white. -->
        <ctl:ActionToggleButton Name="FillCustomButton" Classes="icon tool" Margin="2,0,0,0"
                                Classes.active="{Binding IsRedactionFillCustom}" IsChecked="{Binding IsRedactionFillCustom, Mode=OneWay}"
                                ToolTip.Tip="{x:Static res:Strings.RedactFillCustomTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RedactFillCustom}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.Droplet}" />
            <StackPanel Name="FillCustomDetail" Orientation="Horizontal" Spacing="6">
              <Border Name="FillSwatch" Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                      BorderThickness="1" BorderBrush="{DynamicResource Pw.Brush.Border.Strong}"
                      IsVisible="{Binding IsRedactionFillCustom}" />
              <TextBlock Name="FillCustomLabel" Classes="body" Margin="0" VerticalAlignment="Center" Text="{x:Static res:Strings.RedactFillCustom}" />
            </StackPanel>
          </StackPanel>
          <ctl:ActionToggleButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Name="FillFlyoutContent" Spacing="8" MinWidth="220">
                <TextBlock Classes="body" Text="{x:Static res:Strings.RedactFillHexLabel}"
                           Foreground="{DynamicResource Pw.Brush.Text.Secondary}" />
                <TextBox Name="FillHexBox" MaxLength="7"
                         AutomationProperties.Name="{x:Static res:Strings.RedactFillHexLabel}" />
                <TextBlock Name="FillHexError" Classes="body" TextWrapping="Wrap" IsVisible="False"
                           Foreground="{DynamicResource Pw.Brush.Text.Primary}"
                           Text="{x:Static res:Strings.RedactFillHexError}"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel Name="FillPresets" Orientation="Horizontal" Spacing="4" />
              </StackPanel>
            </Flyout>
          </ctl:ActionToggleButton.Flyout>
        </ctl:ActionToggleButton>

        <!-- "Image areas": what the parts of images under the marks become. One button with the chosen treatment in words next to
             its name (so the state is never told by colour alone); its flyout has the three treatments, the two strengths of the
             blocks (possible while pixelating or blurring is chosen) and the sentence that text in images can stay legible, which
             Pagewing cannot see. The DataContext of the flyout is set in the code behind (a popup is outside the visual tree). -->
        <ctl:ActionToggleButton Name="ImageAreasButton" Classes="icon tool" Margin="2,0,0,0"
                                Classes.active="{Binding IsRedactionImageTreated}" IsChecked="{Binding IsRedactionImageTreated, Mode=OneWay}"
                                ToolTip.Tip="{x:Static res:Strings.RedactImageAreasTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RedactImageAreas}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.LayoutGrid}" />
            <StackPanel Name="ImageAreasDetail" Orientation="Horizontal" Spacing="6">
              <TextBlock Name="ImageAreasLabel" Classes="body" Margin="0" VerticalAlignment="Center" Text="{x:Static res:Strings.RedactImageAreas}" />
              <TextBlock Name="ImageAreasValue" Classes="body" Margin="0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Pw.Brush.Text.Secondary}" Text="{Binding RedactionImageTreatmentText}" />
            </StackPanel>
          </StackPanel>
          <ctl:ActionToggleButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Name="ImageAreasFlyoutContent" Spacing="8" MinWidth="260" MaxWidth="380">
                <TextBlock Classes="body" Text="{x:Static res:Strings.RedactImageAreas}"
                           Foreground="{DynamicResource Pw.Brush.Text.Secondary}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ctl:ActionToggleButton Name="ImageSolidButton" Classes="icon tool"
                                          Classes.active="{Binding IsRedactionImageSolid}" IsChecked="{Binding IsRedactionImageSolid, Mode=OneWay}"
                                          Command="{Binding SetRedactionImageTreatmentCommand}" CommandParameter="{x:Static red:RedactionImageTreatment.Solid}"
                                          ToolTip.Tip="{x:Static res:Strings.RedactImageSolidTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.RedactImageSolid}">
                    <TextBlock Classes="body" Margin="0" Text="{x:Static res:Strings.RedactImageSolid}" />
                  </ctl:ActionToggleButton>
                  <ctl:ActionToggleButton Name="ImagePixelateButton" Classes="icon tool"
                                          Classes.active="{Binding IsRedactionImagePixelate}" IsChecked="{Binding IsRedactionImagePixelate, Mode=OneWay}"
                                          Command="{Binding SetRedactionImageTreatmentCommand}" CommandParameter="{x:Static red:RedactionImageTreatment.Pixelate}"
                                          ToolTip.Tip="{x:Static res:Strings.RedactImagePixelateTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.RedactImagePixelate}">
                    <TextBlock Classes="body" Margin="0" Text="{x:Static res:Strings.RedactImagePixelate}" />
                  </ctl:ActionToggleButton>
                  <ctl:ActionToggleButton Name="ImageBlurButton" Classes="icon tool"
                                          Classes.active="{Binding IsRedactionImageBlur}" IsChecked="{Binding IsRedactionImageBlur, Mode=OneWay}"
                                          Command="{Binding SetRedactionImageTreatmentCommand}" CommandParameter="{x:Static red:RedactionImageTreatment.Blur}"
                                          ToolTip.Tip="{x:Static res:Strings.RedactImageBlurTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.RedactImageBlur}">
                    <TextBlock Classes="body" Margin="0" Text="{x:Static res:Strings.RedactImageBlur}" />
                  </ctl:ActionToggleButton>
                </StackPanel>
                <TextBlock Classes="body" Text="{x:Static res:Strings.RedactImageStrengthLabel}"
                           Foreground="{DynamicResource Pw.Brush.Text.Secondary}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ctl:ActionToggleButton Name="ImageCoarseButton" Classes="icon tool"
                                          Classes.active="{Binding IsRedactionImageCoarse}" IsChecked="{Binding IsRedactionImageCoarse, Mode=OneWay}"
                                          Command="{Binding SetRedactionImageStrengthCommand}" CommandParameter="{x:Static red:RedactionImageStrength.Coarse}"
                                          ToolTip.Tip="{x:Static res:Strings.RedactImageCoarseTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.RedactImageCoarse}">
                    <TextBlock Classes="body" Margin="0" Text="{x:Static res:Strings.RedactImageCoarse}" />
                  </ctl:ActionToggleButton>
                  <ctl:ActionToggleButton Name="ImageVeryCoarseButton" Classes="icon tool"
                                          Classes.active="{Binding IsRedactionImageVeryCoarse}" IsChecked="{Binding IsRedactionImageVeryCoarse, Mode=OneWay}"
                                          Command="{Binding SetRedactionImageStrengthCommand}" CommandParameter="{x:Static red:RedactionImageStrength.VeryCoarse}"
                                          ToolTip.Tip="{x:Static res:Strings.RedactImageVeryCoarseTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.RedactImageVeryCoarse}">
                    <TextBlock Classes="body" Margin="0" Text="{x:Static res:Strings.RedactImageVeryCoarse}" />
                  </ctl:ActionToggleButton>
                </StackPanel>
                <TextBlock Name="ImageCautionText" Classes="body" TextWrapping="Wrap"
                           Foreground="{DynamicResource Pw.Brush.Text.Primary}"
                           Text="{x:Static res:Strings.RedactImageCaution}" />
              </StackPanel>
            </Flyout>
          </ctl:ActionToggleButton.Flyout>
        </ctl:ActionToggleButton>

        <Border Classes="toolbarSeparator" />

        <Button Name="UndoButton" Classes="icon toolbarIcon"
                Command="{Binding UndoCommand}"
                AutomationProperties.Name="{x:Static res:Strings.CommandUndo}">
          <ctl:StrokeIcon Width="18" Height="18" Data="{StaticResource Pw.Icon.ArrowBackUp}" />
        </Button>
        <Button Name="RedoButton" Classes="icon toolbarIcon" Margin="2,0,0,0"
                Command="{Binding RedoCommand}"
                AutomationProperties.Name="{x:Static res:Strings.CommandRedo}">
          <ctl:StrokeIcon Width="18" Height="18" Data="{StaticResource Pw.Icon.ArrowForwardUp}" />
        </Button>
        <Button Name="DeleteMarksButton" Classes="icon toolbarIcon" Margin="2,0,0,0"
                Command="{Binding DeleteMarksCommand}"
                ToolTip.Tip="{x:Static res:Strings.CommandRedactDeleteMarks}"
                AutomationProperties.Name="{x:Static res:Strings.CommandRedactDeleteMarks}">
          <ctl:StrokeIcon Width="18" Height="18" Data="{StaticResource Pw.Icon.Trash}" />
        </Button>

        <Border Classes="toolbarSeparator" />

        <ctl:ActionToggleButton Name="PreviewButton" Classes="icon tool"
                                Classes.active="{Binding IsRedactionPreview}" IsChecked="{Binding IsRedactionPreview, Mode=OneWay}"
                                Command="{Binding ToggleRedactionPreviewCommand}"
                                ToolTip.Tip="{x:Static res:Strings.RedactPreviewTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RedactPreviewButton}">
          <StackPanel Orientation="Horizontal">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.Eye}" />
            <TextBlock Name="PreviewLabel" Classes="body" Text="{x:Static res:Strings.RedactPreviewButton}" />
          </StackPanel>
        </ctl:ActionToggleButton>
      </StackPanel>

      <StackPanel Name="EndArea" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="12,0,0,0">
        <TextBlock Name="PlanHint" Classes="body" VerticalAlignment="Center"
                   Foreground="{DynamicResource Pw.Brush.Text.Secondary}"
                   Text="{x:Static res:Strings.RedactPlanHint}" />
        <TextBlock Name="CounterText" Classes="strong" VerticalAlignment="Center"
                   Foreground="{DynamicResource Pw.Brush.Text.Primary}"
                   Text="{Binding RedactionCounterText}"
                   AutomationProperties.LiveSetting="Polite" />
        <Button Name="DiscardButton" Classes="tool"
                Command="{Binding DiscardRedactionsCommand}"
                ToolTip.Tip="{x:Static res:Strings.CommandRedactDiscard}"
                AutomationProperties.Name="{x:Static res:Strings.CommandRedactDiscard}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.X}" />
            <TextBlock Name="DiscardLabel" VerticalAlignment="Center" Text="{x:Static res:Strings.RedactDiscardButton}" Margin="0" />
          </StackPanel>
        </Button>
        <Button Name="ApplyButton" Classes="primary" VerticalAlignment="Center"
                IsVisible="{Binding HasPendingRedactions}"
                Command="{Binding ApplyRedactionsCommand}"
                ToolTip.Tip="{x:Static res:Strings.RedactApplyTip}"
                AutomationProperties.Name="{x:Static res:Strings.RedactApplyButton}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.EyeOff}" />
            <TextBlock Name="ApplyLabel" VerticalAlignment="Center" Text="{x:Static res:Strings.RedactApplyButton}" />
          </StackPanel>
        </Button>
        <Button Name="DoneButton" Classes.primary="{Binding !HasPendingRedactions}" VerticalAlignment="Center"
                Command="{Binding RedactEntryCommand}"
                ToolTip.Tip="{x:Static res:Strings.RedactDoneTooltip}"
                AutomationProperties.Name="{x:Static res:Strings.RedactDone}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:StrokeIcon Width="18" Height="18" VerticalAlignment="Center" Data="{StaticResource Pw.Icon.Check}" />
            <TextBlock Name="DoneLabel" VerticalAlignment="Center" Text="{x:Static res:Strings.RedactDone}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Border Name="PreviewRow" IsVisible="{Binding IsRedactionPreview}" Padding="12,0,8,8"
            AutomationProperties.Name="{x:Static res:Strings.RedactPreviewBarName}"
            AutomationProperties.AccessibilityView="Content">
      <StackPanel Spacing="2">
        <TextBlock Name="PreviewText" Classes="body" TextWrapping="Wrap"
                   Foreground="{DynamicResource Pw.Brush.Text.Primary}"
                   Text="{Binding RedactionPreviewText}"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Name="PreviewNote" Classes="body" TextWrapping="Wrap"
                   Foreground="{DynamicResource Pw.Brush.Text.Secondary}"
                   Text="{Binding RedactionPreviewNote}" />
      </StackPanel>
    </Border>
    </StackPanel>
  </Border>
</UserControl>
