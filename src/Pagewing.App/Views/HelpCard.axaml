<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             x:Class="Pagewing.App.Views.HelpCard"
             x:DataType="vm:MainViewModel"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="{x:Static res:Strings.HelpTitle}">
  <!--
    The keyboard shortcuts (F1): a card over the window below the title bar, in the style of the link card (design system
    7.5b and 7.8): surface.raised, radius.overlay, card shadow with its 1 px border.subtle edge. Title and close button,
    a filter field (the focus is there; typing filters by title and by shortcut), then every listed command of the catalog
    with a shortcut, grouped as the catalog groups them, the shortcut in type.mono in a 1 px frame as on the start screen.
    Not modal: no background, so clicks beside the card reach the window; Tab stays on the card, Esc and the close button
    close it and the focus goes back where it was (MainWindow.Overlays.cs). Made when it is first shown, never in the
    startup path; the rows are made in code from the catalog each time it is shown.
  -->
  <UserControl.Styles>
    <Style Selector="StackPanel.helpGroup">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="TextBlock.helpGroupTitle">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Grid.helpRow">
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Grid.helpRow > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- kbd: Geist Mono in a 1 px frame; border.strong (3:1) on surface.raised, text.secondary (4.5:1) as in the zoom menu. -->
    <Style Selector="Border.kbd">
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pw.Brush.Border.Strong}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Text.Secondary}" />
    </Style>
  </UserControl.Styles>

  <Border Name="HelpCardBox" Width="560" MaxHeight="600" Margin="24"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          CornerRadius="{StaticResource Pw.Radius.Overlay}"
          Background="{DynamicResource Pw.Brush.Surface.Raised}"
          BoxShadow="{DynamicResource Pw.Shadow.Card}">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,16,12,0">
        <TextBlock Name="HelpTitle" Classes="subtitle" VerticalAlignment="Center" Text="{x:Static res:Strings.HelpTitle}" />
        <Button Name="HelpCloseButton" Grid.Column="1" Classes="icon"
                Command="{Binding HideOverlayCommand}"
                ToolTip.Tip="{x:Static res:Strings.HelpClose}"
                AutomationProperties.Name="{x:Static res:Strings.HelpClose}">
          <ctl:StrokeIcon Width="16" Height="16" Data="{StaticResource Pw.Icon.X}" />
        </Button>
      </Grid>
      <TextBox Name="HelpFilter" DockPanel.Dock="Top" Margin="24,12,24,12"
               PlaceholderText="{x:Static res:Strings.HelpFilter}"
               AutomationProperties.Name="{x:Static res:Strings.HelpFilter}" />
      <TextBlock Name="HelpEmpty" DockPanel.Dock="Top" Classes="body" Margin="24,0,24,20" IsVisible="False"
                 Foreground="{DynamicResource Pw.Brush.Text.Secondary}" Text="{x:Static res:Strings.HelpEmpty}" />
      <ScrollViewer Name="HelpScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Name="HelpGroups" Margin="24,0,24,20" Spacing="16" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
