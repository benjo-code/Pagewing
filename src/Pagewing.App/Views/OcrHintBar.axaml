<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             x:Class="Pagewing.App.Views.OcrHintBar"
             x:DataType="vm:TabViewModel"
             VerticalAlignment="Top"
             AutomationProperties.AccessibilityView="Content"
             AutomationProperties.Name="{x:Static res:Strings.OcrHintText}">
  <!--
    The hint "This looks like a scan. Make it searchable?" (milestone 15), built like the hint bar of a form: one line over the top of the document area,
    below the toolbar of a mode, never blocking, never taking the focus, never starting a run: its button asks for the card. surface.toolbar with a
    border.subtle bottom edge, the information symbol in text.secondary (the kind of the message is never told by colour alone), the text in type.body
    and a polite live region. "Not now" and "Don't ask for this file again" both close it for this document in this tab (nothing is written to disk).
    Made when the active tab first looks like a scan (MainWindow.Ocr.cs), never in the startup path and never in a measurement run. The DataContext is
    the active tab.
  -->
  <Border Name="OcrHintFrame" Padding="12,6,8,6"
          Background="{DynamicResource Pw.Brush.Surface.Toolbar}"
          BorderBrush="{DynamicResource Pw.Brush.Border.Subtle}"
          BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ctl:StrokeIcon Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                      Brush="{DynamicResource Pw.Brush.Text.Secondary}" Data="{StaticResource Pw.Icon.InfoCircle}" />
      <TextBlock Name="OcrHintText" Grid.Column="1" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{DynamicResource Pw.Brush.Text.Primary}"
                 AutomationProperties.LiveSetting="Polite" Text="{x:Static res:Strings.OcrHintText}" />
      <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Name="OcrHintRunButton" Command="{Binding OcrCommand}"
                Content="{x:Static res:Strings.OcrHintButton}" AutomationProperties.Name="{x:Static res:Strings.OcrHintButton}" />
        <Button Name="OcrHintNotNowButton" Command="{Binding DismissOcrHintCommand}"
                Content="{x:Static res:Strings.OcrHintNotNow}" AutomationProperties.Name="{x:Static res:Strings.OcrHintNotNow}" />
        <Button Name="OcrHintNeverButton" Command="{Binding NeverAskOcrCommand}"
                Content="{x:Static res:Strings.OcrHintNever}" AutomationProperties.Name="{x:Static res:Strings.OcrHintNever}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
