<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             x:Class="Pagewing.App.Views.DefaultAppCard"
             x:DataType="vm:DefaultAppViewModel"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"
             AutomationProperties.Name="{x:Static res:Strings.DefaultAppTitle}">
  <!--
    The question "Set Pagewing as the default for PDFs?" at the first start. Built like the card of a print job
    (design system 7.8, the non-modal card at the bottom of the work area): surface.raised, radius.overlay, card shadow,
    it takes no input beside its own area and does not cover the document, and it does not take the focus. Title and
    explanation, then "Don't ask again", "Later" and "Set as default" (primary) from the left, which is the tab order.
    After the system asked the user to choose, or when it failed, a line stands under the text (a polite live region)
    with a symbol: the information symbol for the hint, the warning symbol in danger.default for a failure, so the
    state is never only a colour. Esc on the card is "Later". Made when the question is first answered with "not the
    default" (MainWindow.DefaultApp.cs), never in the startup path.
  -->
  <UserControl.Styles>
    <Style Selector="TextBlock.failed">
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Danger.Default}" />
    </Style>
  </UserControl.Styles>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding LaterCommand}" />
  </UserControl.KeyBindings>
  <Border Name="DefaultAppBox" MaxWidth="440" MinWidth="280" Margin="24" Padding="16"
          CornerRadius="{StaticResource Pw.Radius.Overlay}"
          Background="{DynamicResource Pw.Brush.Surface.Raised}"
          BoxShadow="{DynamicResource Pw.Shadow.Card}">
    <Grid ColumnDefinitions="Auto,*">
      <ctl:StrokeIcon Width="16" Height="16" Margin="0,2,10,0" VerticalAlignment="Top"
                      Data="{StaticResource Pw.Icon.FileText}" />
      <StackPanel Grid.Column="1" Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Name="DefaultAppTitle" Classes="subtitle" TextWrapping="Wrap" Text="{x:Static res:Strings.DefaultAppTitle}" />
          <TextBlock Name="DefaultAppText" Classes="body" TextWrapping="Wrap"
                     Foreground="{DynamicResource Pw.Brush.Text.Secondary}"
                     Text="{x:Static res:Strings.DefaultAppText}" />
        </StackPanel>

        <DockPanel IsVisible="{Binding HasMessage}">
          <ctl:StrokeIcon Name="DefaultAppInfo" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top"
                          Data="{StaticResource Pw.Icon.InfoCircle}" IsVisible="{Binding !IsFailed}" />
          <ctl:StrokeIcon Name="DefaultAppWarning" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top"
                          Brush="{DynamicResource Pw.Brush.Danger.Default}" Data="{StaticResource Pw.Icon.AlertTriangle}"
                          IsVisible="{Binding IsFailed}" />
          <TextBlock Name="DefaultAppMessage" Classes="caption" Classes.failed="{Binding IsFailed}" TextWrapping="Wrap"
                     Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Name="DefaultAppNeverButton" Command="{Binding NeverCommand}" Content="{x:Static res:Strings.DefaultAppNever}" />
          <Button Name="DefaultAppLaterButton" Command="{Binding LaterCommand}" Content="{x:Static res:Strings.DefaultAppLater}" />
          <Button Name="DefaultAppSetButton" Classes="primary" Command="{Binding SetDefaultCommand}" Content="{x:Static res:Strings.DefaultAppSet}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
