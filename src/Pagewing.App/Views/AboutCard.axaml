<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             x:Class="Pagewing.App.Views.AboutCard"
             x:DataType="vm:AboutViewModel"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="{x:Static res:Strings.AboutTitle}">
  <!--
    About Pagewing (command "About Pagewing" in the palette, no key): a card over the window below the title bar like the
    help card (design system 7.5b and 7.8): surface.raised, radius.overlay, card shadow. Name, version, licence and the
    offline line in the tokens of the other cards (text.primary, text.secondary on surface.raised, both 4.5:1 or better),
    then a button that opens the third-party notices. No link: an external address must go through the confirmation card.
    The notices are about 390 KB, read only when the list is first opened, and cut into rows of a few lines in a list
    that makes only the rows in view (VirtualizingStackPanel): one text block of that size would freeze the window.
    Not modal, Tab stays on the card, Esc and the close button close it (MainWindow.Overlays.cs). Made when it is first
    shown, never in the startup path.
  -->
  <UserControl.Styles>
    <Style Selector="TextBlock.noticeTitle">
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style Selector="TextBlock.noticeText">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Styles>

  <Border Name="AboutBox" Width="520" MaxHeight="600" Margin="24"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          CornerRadius="{StaticResource Pw.Radius.Overlay}"
          Background="{DynamicResource Pw.Brush.Surface.Raised}"
          BoxShadow="{DynamicResource Pw.Shadow.Card}">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,16,12,0">
        <TextBlock Name="AboutName" Classes="subtitle" VerticalAlignment="Center" Text="{Binding Name}"
                   AutomationProperties.HeadingLevel="1" />
        <Button Name="AboutCloseButton" Grid.Column="1" Classes="icon"
                ToolTip.Tip="{x:Static res:Strings.AboutClose}"
                AutomationProperties.Name="{x:Static res:Strings.AboutClose}">
          <ctl:StrokeIcon Width="16" Height="16" Data="{StaticResource Pw.Icon.X}" />
        </Button>
      </Grid>
      <StackPanel DockPanel.Dock="Top" Margin="24,8,24,12" Spacing="4">
        <TextBlock Name="AboutVersion" Classes="body" Text="{Binding VersionLine}" />
        <TextBlock Name="AboutLicense" Classes="body" Text="{Binding LicenseLine}" />
        <TextBlock Name="AboutOffline" Classes="body" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource Pw.Brush.Text.Secondary}" Text="{Binding OfflineLine}" />
      </StackPanel>
      <ToggleButton Name="NoticesToggle" DockPanel.Dock="Top" Margin="24,0,24,12" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" IsChecked="{Binding NoticesOpen, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Static res:Strings.AboutNotices}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="body" VerticalAlignment="Center" Text="{x:Static res:Strings.AboutNotices}" />
          <ctl:StrokeIcon Name="NoticesChevronDown" Grid.Column="1" Width="16" Height="16" Data="{StaticResource Pw.Icon.ChevronDown}" />
          <ctl:StrokeIcon Name="NoticesChevronUp" Grid.Column="1" Width="16" Height="16" IsVisible="False" Data="{StaticResource Pw.Icon.ChevronUp}" />
        </Grid>
      </ToggleButton>
      <Border Name="NoticesBox" Height="280" Margin="24,0,24,20" IsVisible="False"
              BorderThickness="1" BorderBrush="{DynamicResource Pw.Brush.Border.Strong}" CornerRadius="4">
        <ItemsControl Name="NoticesList" Margin="12,0">
          <ItemsControl.Template>
            <ControlTemplate>
              <ScrollViewer Name="NoticesScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NoticeRow">
              <TextBlock Classes="mono noticeText" Classes.strong="{Binding IsTitle}" Classes.noticeTitle="{Binding IsTitle}"
                         Foreground="{DynamicResource Pw.Brush.Text.Primary}" Text="{Binding Text}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </DockPanel>
  </Border>
</UserControl>
