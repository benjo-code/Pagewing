<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             x:Class="Pagewing.App.Views.StatusBar"
             x:DataType="vm:TabViewModel"
             Height="32" FontSize="12"
             Background="{DynamicResource Pw.Brush.Surface.Window}"
             Foreground="{DynamicResource Pw.Brush.Text.Secondary}">
  <!--
    Status bar (design system section 6, item 5): ‹ "Page" [field] "of N" ›, separator, zoom − [value] +, separator,
    layout. Text type.caption in text.secondary, icons 16 px. Below 760 px the word "Page" and the name of the layout
    go (code-behind); the icons stay, with their tooltips. The page field jumps on Enter; an invalid entry, or leaving
    the field without Enter, puts the current page back (design system 7.5). Ctrl+G gives it the focus with its
    content selected. A click on the zoom value opens the zoom menu: the steps from 25 to 400 %, then page width, whole
    page and actual size. The layout button opens the layout menu: single page, continuous, two pages, two pages with
    cover. At the right edge "Document info" opens the document info popup (design system 7.6), which is created
    when it opens (StatusBar.DocumentInfo.cs); below 760 px its label goes as well.
  -->
  <UserControl.Styles>
    <Style Selector="Button.status">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Text.Secondary}" />
    </Style>
    <Style Selector="Button.status-value">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Foreground" Value="{DynamicResource Pw.Brush.Text.Secondary}" />
    </Style>
  </UserControl.Styles>

  <!--
    Indented by the action bar (52) plus 4 (design system 6, item 5); the bar itself spans the window, so its width is
    the window width. Navigation, zoom and layout on the left, the document info on the right; the order of the
    children is the order of Tab.
  -->
  <Grid Name="BarLayout" ColumnDefinitions="*,Auto" Margin="56,0,8,0" VerticalAlignment="Center">
    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
      <Button Name="PreviousPageButton" Classes="icon status"
              Command="{Binding PreviousPageCommand}"
              ToolTip.Tip="{x:Static res:Strings.PreviousPage}"
              AutomationProperties.Name="{x:Static res:Strings.PreviousPage}">
        <ctl:StrokeIcon Width="16" Height="16" Data="{StaticResource Pw.Icon.ChevronLeft}" />
      </Button>
      <TextBlock Name="PageLabel" VerticalAlignment="Center" Text="{x:Static res:Strings.PageLabel}" />
      <TextBox Name="PageField"
               Width="40" Height="22" MinHeight="22" Padding="2,0" FontSize="12" FontFeatures="+tnum"
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               Text="{Binding PageFieldText}"
               ToolTip.Tip="{x:Static res:Strings.GoToPageTooltip}"
               AutomationProperties.Name="{x:Static res:Strings.PageLabel}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding CommitPageFieldCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <TextBlock Name="PageCountText" Classes="num" VerticalAlignment="Center" Text="{Binding PageCountText}" />
      <Button Name="NextPageButton" Classes="icon status"
              Command="{Binding NextPageCommand}"
              ToolTip.Tip="{x:Static res:Strings.NextPage}"
              AutomationProperties.Name="{x:Static res:Strings.NextPage}">
        <ctl:StrokeIcon Width="16" Height="16" Data="{StaticResource Pw.Icon.ChevronRight}" />
      </Button>

      <Border Width="1" Height="22" Margin="6,0" Background="{DynamicResource Pw.Brush.Border.Subtle}" />

      <Button Name="ZoomOutButton" Classes="icon status"
              Command="{Binding ZoomOutCommand}"
              ToolTip.Tip="{x:Static res:Strings.ZoomOut}"
              AutomationProperties.Name="{x:Static res:Strings.ZoomOut}">
        <ctl:StrokeIcon Width="16" Height="16" Data="{StaticResource Pw.Icon.Minus}" />
      </Button>
      <!-- The zoom value opens the zoom menu (design system 7.5); its entries are created when it opens (StatusBar.axaml.cs). -->
      <Button Name="ZoomMenuButton" Classes="icon status-value"
              ToolTip.Tip="{x:Static res:Strings.ZoomMenuTooltip}"
              AutomationProperties.Name="{x:Static res:Strings.ZoomValue}">
        <TextBlock Name="ZoomValueText" Classes="num" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center"
                   Text="{Binding ZoomText}"
                   AutomationProperties.Name="{x:Static res:Strings.ZoomValue}" />
        <Button.Flyout>
          <MenuFlyout Placement="TopEdgeAlignedLeft" />
        </Button.Flyout>
      </Button>
      <Button Name="ZoomInButton" Classes="icon status"
              Command="{Binding ZoomInCommand}"
              ToolTip.Tip="{x:Static res:Strings.ZoomIn}"
              AutomationProperties.Name="{x:Static res:Strings.ZoomIn}">
        <ctl:StrokeIcon Width="16" Height="16" Data="{StaticResource Pw.Icon.Plus}" />
      </Button>

      <Border Width="1" Height="22" Margin="6,0" Background="{DynamicResource Pw.Brush.Border.Subtle}" />

      <!--
        The layout: icon and name of the current layout (below 760 px the icon only), tooltip and automation name set in
        code-behind; its menu entries are created when it opens (StatusBar.axaml.cs).
      -->
      <Button Name="LayoutButton" Classes="icon status-value" Padding="4,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ctl:StrokeIcon Name="LayoutIcon" Width="16" Height="16" VerticalAlignment="Center"
                          Data="{StaticResource Pw.Icon.LayoutRows}" />
          <TextBlock Name="LayoutText" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="TopEdgeAlignedLeft" />
        </Button.Flyout>
      </Button>
    </StackPanel>

    <!-- Document info: icon and label (below 760 px the icon only); only for an open document. -->
    <Button Name="DocumentInfoButton" Grid.Column="1" Classes="icon status-value" Padding="4,0"
            IsVisible="{Binding IsReady}"
            ToolTip.Tip="{x:Static res:Strings.DocumentInfo}"
            AutomationProperties.Name="{x:Static res:Strings.DocumentInfo}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ctl:StrokeIcon Name="DocumentInfoIcon" Width="16" Height="16" VerticalAlignment="Center"
                        Data="{StaticResource Pw.Icon.InfoCircle}" />
        <TextBlock Name="DocumentInfoText" VerticalAlignment="Center" Text="{x:Static res:Strings.DocumentInfo}" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
