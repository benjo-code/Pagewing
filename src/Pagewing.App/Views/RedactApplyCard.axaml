<views:SaveCard xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:Pagewing.App.ViewModels"
                xmlns:views="using:Pagewing.App.Views"
                xmlns:ctl="using:Pagewing.App.Controls"
                xmlns:res="using:Pagewing.App.Resources"
                x:Class="Pagewing.App.Views.RedactApplyCard"
                x:DataType="vm:PendingSave"
                AutomationProperties.Name="{Binding Title}"
                AutomationProperties.HelpText="{Binding Message}">
  <!--
    Before the marks are applied (milestone 14, PendingSaveKind.ApplyRedactions; design system 7.14), and when the file cannot be
    redacted or the check found something (PendingSaveKind.RedactionRefused and RedactionFailed, which have "Back" alone and no
    "Apply"): warning symbol in danger.default, the title, the summary ("Removes: 38 characters, 1 image; 1 text object as a
    whole"), the parts of the card (what is removed as a whole, what is cleaned, what changes, what is NOT cleaned and not checked,
    what will be checked; for a refusal the kind, the reason and the pages; for a failed check the findings), the sentence that
    redacting cannot be undone, and "Save as …" (primary, focus and Enter: the original stays), "Save in the original file"
    (dangerous: locked for the first 400 ms, never the default) and "Back". A long list scrolls inside the card; the buttons wrap
    in a narrow card. No text calls anything valid or promises more than the check does. Esc answers "Back" (the marks stay). Card
    and buttons as SaveCard; made with the first such question (MainWindow.SaveCards.cs).

    PendingSaveKind.RedactionRescue (milestone 14.1) is a refusal for pages alone: under the reasons it offers each page as an
    image (a check box, never preselected, with what the choice costs: resolution, pixels, the size the file grows by at most), one
    choice of the resolution (150, 200 or 300 dpi) and the buttons "Continue" (waits for a chosen page) and "Back" (default).
  -->
  <Border Name="RedactApplyBox" MaxWidth="560" Margin="24" Padding="24"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          CornerRadius="{StaticResource Pw.Radius.Overlay}"
          Background="{DynamicResource Pw.Brush.Surface.Raised}"
          BoxShadow="{DynamicResource Pw.Shadow.Card}">
    <StackPanel Spacing="12">
      <ctl:StrokeIcon Name="RedactApplyIcon" Width="24" Height="24" HorizontalAlignment="Left"
                      Data="{StaticResource Pw.Icon.AlertTriangle}"
                      Brush="{DynamicResource Pw.Brush.Danger.Default}" />
      <StackPanel Spacing="4">
        <TextBlock Name="RedactApplyTitle" Classes="subtitle" TextWrapping="Wrap" Text="{Binding Title}"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Name="RedactApplySummary" Classes="body" TextWrapping="Wrap"
                   IsVisible="{Binding Redaction.HasSummary}" Text="{Binding Redaction.Summary}" />
      </StackPanel>

      <ScrollViewer Name="RedactApplyScroller" MaxHeight="340"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
        <ItemsControl Name="RedactApplySections" ItemsSource="{Binding Redaction.Sections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RedactionSection">
              <StackPanel Spacing="4">
                <TextBlock Classes="body" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Heading}" />
                <ItemsControl ItemsSource="{Binding Lines}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Classes="body" Text="•" Foreground="{DynamicResource Pw.Brush.Text.Secondary}" />
                        <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Pw.Brush.Text.Secondary}" Text="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The offer of a refusal for pages alone: only there (Rescue is null for every other card). -->
        <StackPanel IsVisible="{Binding Rescue, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Name="RedactRescueBox" Spacing="8" DataContext="{Binding Rescue}" x:DataType="vm:RedactionRescueOffer">
          <TextBlock Name="RedactRescueIntro" Classes="body" TextWrapping="Wrap"
                     Text="{x:Static res:Strings.RedactRescueIntro}" />
          <ItemsControl Name="RedactRescuePages" ItemsSource="{Binding Pages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RasterRescuePage">
                <StackPanel Spacing="2">
                  <CheckBox Name="RedactRescueCheck" IsChecked="{Binding IsChosen, Mode=TwoWay}"
                            Content="{x:Static res:Strings.RedactRescueChoice}"
                            AutomationProperties.Name="{Binding ChoiceAutomationName}" />
                  <TextBlock Name="RedactRescueEstimate" Classes="caption" TextWrapping="Wrap" Margin="28,0,0,0"
                             Foreground="{DynamicResource Pw.Brush.Text.Secondary}"
                             Text="{Binding EstimateText}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="4">
            <TextBlock Name="RedactRescueDpiLabel" Classes="body" FontWeight="SemiBold"
                       Text="{x:Static res:Strings.RedactRescueDpiLabel}" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton Name="RedactRescueDpi150" GroupName="RedactRescueDpi" IsChecked="{Binding IsDpi150, Mode=TwoWay}"
                           Content="{x:Static res:Strings.RedactRasterDpi150}"
                           AutomationProperties.Name="{x:Static res:Strings.RedactRasterDpi150}" />
              <RadioButton Name="RedactRescueDpi200" GroupName="RedactRescueDpi" IsChecked="{Binding IsDpi200, Mode=TwoWay}"
                           Content="{x:Static res:Strings.RedactRasterDpi200}"
                           AutomationProperties.Name="{x:Static res:Strings.RedactRasterDpi200}" />
              <RadioButton Name="RedactRescueDpi300" GroupName="RedactRescueDpi" IsChecked="{Binding IsDpi300, Mode=TwoWay}"
                           Content="{x:Static res:Strings.RedactRasterDpi300}"
                           AutomationProperties.Name="{x:Static res:Strings.RedactRasterDpi300}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <TextBlock Name="RedactApplyMessage" Classes="body" FontWeight="SemiBold" TextWrapping="Wrap"
                 Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" />

      <WrapPanel Name="RedactApplyButtons" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="RedactContinueButton" Margin="8,0,0,8" />
        <Button Name="RedactSaveAsButton" Margin="8,0,0,8" />
        <Button Name="RedactSaveInOriginalButton" Margin="8,0,0,8" />
        <Button Name="RedactBackButton" Margin="8,0,0,8" />
      </WrapPanel>
    </StackPanel>
  </Border>
</views:SaveCard>
