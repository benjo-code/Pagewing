<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             x:Class="Pagewing.App.Views.PasswordCard"
             x:DataType="vm:TabViewModel">
  <!--
    Password card (design system section 7.8): instead of a modal dialog it replaces the document area of the tab.
    Lock symbol, title, prompt with the file name, password field with the focus, "Cancel" (closes the tab) and
    "Open" (also Enter). A wrong password turns the field border danger.default, keeps the focus in the field with its
    content selected (code-behind) and shows the message as text with a symbol, never by colour alone (section 7.10).
    Card: surface.raised, radius.overlay, card shadow (section 5.3).
  -->
  <Border MaxWidth="420" Margin="24" Padding="24"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          CornerRadius="{StaticResource Pw.Radius.Overlay}"
          Background="{DynamicResource Pw.Brush.Surface.Raised}"
          BoxShadow="{DynamicResource Pw.Shadow.Card}">
    <StackPanel Spacing="12">
      <ctl:StrokeIcon Width="24" Height="24" HorizontalAlignment="Left"
                      Data="{StaticResource Pw.Icon.Lock}"
                      Brush="{DynamicResource Pw.Brush.Text.Secondary}" />
      <StackPanel Spacing="4">
        <TextBlock Classes="subtitle" TextWrapping="Wrap" Text="{x:Static res:Strings.PasswordTitle}" />
        <TextBlock Name="PasswordPrompt" Classes="body" TextWrapping="Wrap"
                   Foreground="{DynamicResource Pw.Brush.Text.Secondary}"
                   Text="{Binding PasswordPromptText}" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBox Name="PasswordField" PasswordChar="•"
                 Text="{Binding Password}"
                 Classes.invalid="{Binding IsPasswordIncorrect}"
                 AutomationProperties.Name="{x:Static res:Strings.PasswordField}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SubmitPasswordCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <DockPanel IsVisible="{Binding IsPasswordIncorrect}">
          <ctl:StrokeIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top"
                          Data="{StaticResource Pw.Icon.AlertTriangle}"
                          Brush="{DynamicResource Pw.Brush.Danger.Default}" />
          <TextBlock Name="PasswordMessage" Classes="caption" TextWrapping="Wrap"
                     Foreground="{DynamicResource Pw.Brush.Danger.Default}"
                     Text="{x:Static res:Strings.PasswordIncorrect}" />
        </DockPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="PasswordCancelButton"
                Command="{Binding CancelPasswordCommand}"
                Content="{x:Static res:Strings.PasswordCancel}" />
        <Button Name="PasswordOpenButton" Classes="primary"
                Command="{Binding SubmitPasswordCommand}"
                Content="{x:Static res:Strings.PasswordOpen}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
