<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pagewing.App.ViewModels"
             xmlns:ctl="using:Pagewing.App.Controls"
             xmlns:res="using:Pagewing.App.Resources"
             x:Class="Pagewing.App.Views.ErrorCard"
             x:DataType="vm:MainViewModel">
  <!--
    Error card (design system section 7.8) in the document area of the tab: warning symbol in danger.default, title,
    the cause in everyday words per error kind, collapsible "Technical details" (full path and error kind, selectable
    for copying), "Close tab" and "Open another file" (primary). Card: surface.raised, radius.overlay, card shadow.
  -->
  <Border MaxWidth="480" Margin="24" Padding="24"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          CornerRadius="{StaticResource Pw.Radius.Overlay}"
          Background="{DynamicResource Pw.Brush.Surface.Raised}"
          BoxShadow="{DynamicResource Pw.Shadow.Card}">
    <StackPanel Spacing="12">
      <ctl:StrokeIcon Width="24" Height="24" HorizontalAlignment="Left"
                      Data="{StaticResource Pw.Icon.AlertTriangle}"
                      Brush="{DynamicResource Pw.Brush.Danger.Default}" />
      <StackPanel Spacing="4">
        <TextBlock Name="ErrorTitle" Classes="subtitle" TextWrapping="Wrap" Text="{x:Static res:Strings.ErrorTitle}" />
        <TextBlock Name="ErrorCause" Classes="body" TextWrapping="Wrap"
                   Foreground="{DynamicResource Pw.Brush.Text.Secondary}"
                   Text="{Binding ErrorCauseText}" />
      </StackPanel>

      <Expander Name="ErrorDetails" HorizontalAlignment="Stretch" Header="{x:Static res:Strings.ErrorDetails}">
        <SelectableTextBlock Name="ErrorDetailsText" TextWrapping="Wrap"
                             FontFamily="{DynamicResource Pw.Font.Mono}" FontSize="11.5" LineHeight="16"
                             Text="{Binding ErrorDetailsText}" />
      </Expander>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="ErrorCloseButton"
                Command="{Binding CloseCommand}"
                Content="{x:Static res:Strings.ErrorCloseTab}" />
        <Button Name="ErrorOpenOtherButton" Classes="primary"
                Command="{Binding OpenCommand}"
                Content="{x:Static res:Strings.ErrorOpenOther}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
